# ============================================================
# GroundTruth Kiosk — Environment Variables
# ============================================================
# Copy this file to .env and fill in values for local dev.
# In production, these are set via /etc/groundtruth/kiosk.env
# loaded by the systemd EnvironmentFile= directive.
#
# NEVER commit a filled-in .env to version control.
# NEVER hardcode any of these values in source code.
# ============================================================

# ----------------------------------------------------------
# Kiosk Identity (implementation.md §11)
# ----------------------------------------------------------
KIOSK_ID=DEV-KIOSK-001

# GeoJSON Polygon (WGS84) bounding this kiosk's service area.
# The default below is a small box near Pune for demo purposes.
KIOSK_GEOFENCE_GEOJSON={"type":"Polygon","coordinates":[[[73.85,18.51],[73.86,18.51],[73.86,18.52],[73.85,18.52],[73.85,18.51]]]}

# ----------------------------------------------------------
# Sync / Regional Gateway (architecture.md §4.7, §12.2)
# ----------------------------------------------------------
GATEWAY_URL=https://gateway.groundtruth.example

# Paths to the kiosk's mTLS client certificate and private key.
# Provisioned at kiosk imaging time (implementation.md §10.1).
KIOSK_CERT_PATH=/etc/groundtruth/certs/kiosk.crt
KIOSK_KEY_PATH=/etc/groundtruth/certs/kiosk.key

# Set to "true" to skip mTLS and use plain HTTPS for local dev / hackathon demo.
# MUST be "false" in production.
SKIP_MTLS=true

SYNC_POLL_INTERVAL_S=60
SYNC_BASE_BACKOFF_S=5
SYNC_MAX_BACKOFF_S=300
SYNC_MAX_ATTEMPTS=5

# ----------------------------------------------------------
# Model Paths (implementation.md §11, §2.1)
# ----------------------------------------------------------
ASR_MODEL_PATH=models/asr/ggml-small-q8_0.bin
LLM_MODEL_PATH=models/llm/gemma-2-2b-it-groundtruth-lora.Q4_K_M.gguf
CV_MODEL_PATH=models/cv/change-detection-unet-mbv3.onnx
GRAMMAR_PATH=kiosk_agent/grammar/structured_complaint.gbnf
PROMPTS_DIR=kiosk_agent/prompts

# ----------------------------------------------------------
# ASR Settings (architecture.md §4.1)
# ----------------------------------------------------------
ASR_MAX_DURATION_S=90
ASR_CONFIDENCE_THRESHOLD=0.55
# Optional ISO-639-1 language hint passed to Whisper (leave blank to auto-detect).
ASR_LANGUAGE_HINT=

# ----------------------------------------------------------
# Structuring Engine (architecture.md §4.2)
# ----------------------------------------------------------
STRUCTURING_TIMEOUT_S=20

# Set to "true" if the GGUF model binary is not yet available.
# The engine will return a hardcoded schema-conformant stub response.
# MUST be "false" in production / demo with real model.
STUB_STRUCTURING=true

# ----------------------------------------------------------
# Verification Engine — category change_score thresholds
# (architecture.md §4.4)
# ----------------------------------------------------------
VERIFICATION_THRESHOLDS_JSON={"ROAD":0.4,"WATER":0.45,"ELECTRICITY":0.4,"SANITATION":0.35,"STREETLIGHT":0.4,"OTHER":0.3}

# ----------------------------------------------------------
# Urgency Scoring Weights (architecture.md §4.6)
# ----------------------------------------------------------
URGENCY_WEIGHTS_JSON={"severity":0.40,"recency":0.20,"category":0.25,"duplicate":0.15}
CATEGORY_WEIGHTS_JSON={"WATER":0.9,"ELECTRICITY":0.85,"ROAD":0.7,"SANITATION":0.6,"STREETLIGHT":0.5,"OTHER":0.3}
URGENCY_SLA_BREACH_HOURS=72

# ----------------------------------------------------------
# Database (architecture.md §8, §ADR-003)
# ----------------------------------------------------------
DB_PATH=groundtruth_kiosk.db

# SQLCipher encryption passphrase for data-at-rest encryption.
# Leave EMPTY for unencrypted dev/CI database.
# In production, set to a strong random passphrase (e.g. openssl rand -hex 32).
DB_ENCRYPTION_KEY=

# ----------------------------------------------------------
# Storage & Sync Status Indicator Thresholds (implementation.md §4.7)
# ----------------------------------------------------------
STORAGE_WARN_PCT=80
STORAGE_CRITICAL_PCT=95
SYNC_WARN_AGE_HOURS=6
SYNC_CRITICAL_AGE_HOURS=24

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
# Bind to loopback only — never expose beyond localhost (architecture.md §12.1).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
